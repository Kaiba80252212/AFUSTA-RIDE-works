rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.phone_number is string && request.auth.token.phone_number.size() >= 6)
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Used in allow list blocks (zero get()/exists() calls inside list queries)
    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'abubakarmubarak141@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRole(role) {
      return role in ['STUDENT', 'DRIVER'];
    }

    function isValidRideType(rideType) {
      return rideType in ['normal', 'shared', 'express'];
    }

    function isValidPaymentMethod(method) {
      return method in ['wallet', 'cash'];
    }

    function isValidRideStatus(status) {
      return status in ['Pending', 'Accepted', 'In Progress', 'Completed', 'Cancelled', 'Declined'];
    }

    function isTerminalRideStatus(status) {
      return status in ['Completed', 'Cancelled', 'Declined'];
    }

    // --- Validation Blueprints ---
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'rating', 'available', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'rating', 'available', 'tricyclePlate', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role is string && data.role.size() <= 16 && isValidRole(data.role)
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.available is bool
        && (!('tricyclePlate' in data) || (data.tricyclePlate is string && data.tricyclePlate.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'walletBalance', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'matricNo', 'department', 'licenseNo', 'walletBalance', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && (!('email' in data) || (data.email is string && data.email.size() <= 180))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('matricNo' in data) || (data.matricNo is string && data.matricNo.size() <= 48))
        && (!('department' in data) || (data.department is string && data.department.size() <= 120))
        && (!('licenseNo' in data) || (data.licenseNo is string && data.licenseNo.size() <= 48))
        && data.walletBalance is number && data.walletBalance >= 0 && data.walletBalance <= 10000000
        && data.updatedAt is timestamp;
    }

    function isValidRide(data, rideId) {
      return data.keys().hasAll([
          'id', 'bookingRef', 'studentId', 'driverId', 'fromStopId', 'toStopId',
          'rideType', 'paymentMethod', 'fare', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'bookingRef', 'studentId', 'driverId', 'fromStopId', 'toStopId',
          'rideType', 'paymentMethod', 'fare', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == rideId
        && data.bookingRef is string && data.bookingRef.size() >= 3 && data.bookingRef.size() <= 32
        && isValidId(data.studentId)
        && data.driverId is string && data.driverId.size() <= 128 && (data.driverId == '' || isValidId(data.driverId))
        && data.fromStopId is string && data.fromStopId.size() >= 1 && data.fromStopId.size() <= 64 && isValidId(data.fromStopId)
        && data.toStopId is string && data.toStopId.size() >= 1 && data.toStopId.size() <= 64 && isValidId(data.toStopId)
        && data.fromStopId != data.toStopId
        && data.rideType is string && data.rideType.size() <= 16 && isValidRideType(data.rideType)
        && data.paymentMethod is string && data.paymentMethod.size() <= 16 && isValidPaymentMethod(data.paymentMethod)
        && data.fare is number && data.fare >= 0 && data.fare <= 100000
        && data.status is string && data.status.size() <= 24 && isValidRideStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /admins/{adminId} (Read-only from clients) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && request.auth.uid == userId
        && incoming().rating == 5
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().rating == existing().rating
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'available', 'tricyclePlate', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();

      // --- Subcollection: /users/{userId}/private/{docId} (Master Gate + PII Isolation) ---
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info'
          && exists(/databases/$(database)/documents/users/$(userId))
          && (isOwner(userId) || isAdmin());

        allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isBootstrappedAdmin());

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == request.auth.uid
          && request.auth.uid == userId
          && incoming().walletBalance == 0
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && ((!('email' in incoming()) && !('email' in existing())) || ('email' in incoming() && 'email' in existing() && incoming().email == existing().email))
              && incoming().walletBalance == existing().walletBalance
              && incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'matricNo', 'department', 'licenseNo', 'updatedAt'])
            )
          );

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // --- Collection: /rides/{rideId} ---
    match /rides/{rideId} {
      allow get: if isVerifiedUser()
        && isValidId(rideId)
        && (
          existing().studentId == request.auth.uid ||
          existing().driverId == request.auth.uid ||
          isAdmin()
        );

      allow list: if isVerifiedUser() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(rideId)
        && isValidRide(incoming(), rideId)
        && incoming().studentId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(rideId)
        && isValidRide(incoming(), rideId)
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            !isTerminalRideStatus(existing().status) && (
              // Action: Student cancels a Pending ride
              (
                existing().studentId == request.auth.uid
                && existing().status == 'Pending'
                && incoming().status == 'Cancelled'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              ) ||
              // Action: Assigned driver advances ride lifecycle
              (
                existing().driverId == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                && (
                  (existing().status == 'Pending' && incoming().status in ['Accepted', 'Declined']) ||
                  (existing().status == 'Accepted' && incoming().status in ['In Progress', 'Cancelled']) ||
                  (existing().status == 'In Progress' && incoming().status == 'Completed')
                )
              )
            )
          )
        );

      allow delete: if isValidId(rideId) && isAdmin();
    }
  }
}
